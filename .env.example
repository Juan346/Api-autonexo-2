# Ejemplo: variables de entorno para key_validator_api
MONGODB_URI=mongodb://127.0.0.1:27017/license_db
PORT=4000

# Autenticación del panel admin
JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo
ADMIN_USER=admin
# Genera este valor con: node scripts/hash-password.js <tu-password>
ADMIN_PASSWORD_HASH=

# Días de gracia antes de suspender una licencia por factura vencida
GRACE_PERIOD_DAYS=7

# Origen permitido para CORS, solo se usa como fallback mientras no hayas
# agregado ningún dominio desde /admin-ui/security.html (el panel admin en
# public/admin se sirve same-origin y no lo necesita). Vacío = sin CORS
# cross-origin con credenciales.
CORS_ORIGIN=

# Número de saltos de proxy reverso de confianza delante de este servicio
# (ej. 1 para un solo nginx delante). Vacío/0 = no confiar en X-Forwarded-For
# (por defecto, correcto si el servicio recibe tráfico directo). Afecta qué IP
# ve la lista de IPs permitidas (ver /admin-ui/security.html). NUNCA pongas
# "true": es una confianza permisiva (cualquier cantidad de saltos) que
# permite falsificar la IP de origen encadenando X-Forwarded-For falsos, y el
# límite de intentos de login la rechaza explícitamente por insegura.
TRUST_PROXY=
